IDI_ICON1 ICON DISCARDABLE "cmake/windows/3mix.ico"

1 VERSIONINFO
FILEVERSION ${OBS_VERSION_MAJOR},${OBS_VERSION_MINOR},${OBS_VERSION_PATCH},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "3Mix"
      VALUE "FileDescription", "3Mix Studio"
      VALUE "FileVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "InternalName", "obs"
      VALUE "OriginalFilename", "obs"
      VALUE "ProductName", "3Mix Studio"
      VALUE "ProductVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "Comments", "3Mix broadcast production suite; powered by OBS Studio"
      VALUE "LegalCopyright", "${OBS_LEGAL_COPYRIGHT}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
