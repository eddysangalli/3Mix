+void QCefBrowserClient::OnDraggableRegionsChanged(CefRefPtr<CefBrowser>, CefRefPtr<CefFrame>,
+                                                const std::vector<CefDraggableRegion> &regions)
+{
+	if (!widget) return;
+	QRegion draggable;
+	for (const auto &region : regions) {
+		QRect rect(region.bounds.x, region.bounds.y, region.bounds.width, region.bounds.height);
+		if (region.draggable) draggable += rect;
+		else draggable -= rect;
+	}
+	QPointer<QCefWidgetInternal> target(widget);
+	QMetaObject::invokeMethod(widget, [target, draggable]() {
+		if (!target || !target->property("3mix.nativeHeader").toBool()) return;
+		target->setProperty("3mix.draggableRegion", QVariant::fromValue(draggable));
+	}, Qt::QueuedConnection);
+}
