diff --git a/plugins/obs-vst/EditorWidget.cpp b/plugins/obs-vst/EditorWidget.cpp
index d2dc624..fbed25a 100644
--- a/plugins/obs-vst/EditorWidget.cpp
+++ b/plugins/obs-vst/EditorWidget.cpp
@@ -22,10 +22,20 @@ along with this program.  If not, see <http://www.gnu.org/licenses/>.
 EditorWidget::EditorWidget(QWidget *parent, VSTPlugin *plugin) : QWidget(parent), plugin(plugin)
 {
 	setWindowFlags(this->windowFlags() |= Qt::MSWindowsFixedSizeDialogHint);
+
+	// Editores VST2 so atualizam medidores e animacoes quando o host envia effEditIdle.
+	idleTimer.setInterval(33);
+	connect(&idleTimer, &QTimer::timeout, this, [this]() { this->plugin->idleEditor(); });
+}
+
+void EditorWidget::startEditorIdle()
+{
+	idleTimer.start();
 }
 
 void EditorWidget::closeEvent(QCloseEvent *event)
 {
+	idleTimer.stop();
 	plugin->onEditorClosed();
 	UNUSED_PARAMETER(event);
 }
diff --git a/plugins/obs-vst/VSTPlugin.cpp b/plugins/obs-vst/VSTPlugin.cpp
index 7a093cb..b911bc1 100644
--- a/plugins/obs-vst/VSTPlugin.cpp
+++ b/plugins/obs-vst/VSTPlugin.cpp
@@ -313,6 +313,14 @@ void VSTPlugin::onEditorClosed()
 	}
 }
 
+void VSTPlugin::idleEditor()
+{
+	// Sempre na thread da interface, onde effect muda; sem lockEffect para uma tela lenta nao segurar o audio.
+	if (effect && editorWidget && editorOpened) {
+		effect->dispatcher(effect, effEditIdle, 0, 0, nullptr, 0);
+	}
+}
+
 void VSTPlugin::openEditor()
 {
 	if (effect && !editorWidget) {
@@ -337,6 +345,7 @@ void VSTPlugin::openEditor()
 				QString("%1: %2 - %3").arg(sourceName.c_str(), filterName.c_str(), effectName));
 		}
 		editorWidget->show();
+		editorWidget->startEditorIdle();
 	}
 }
 
