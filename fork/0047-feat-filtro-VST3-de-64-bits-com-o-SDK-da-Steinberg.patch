+//-----------------------------------------------------------------------------
+// Project     : VST SDK
+//
+// Category    : Helpers
+// Filename    : public.sdk/source/vst/utility/optional.h
+// Created by  : Steinberg, 08/2016
+// Description : optional helper
+//
+//-----------------------------------------------------------------------------
