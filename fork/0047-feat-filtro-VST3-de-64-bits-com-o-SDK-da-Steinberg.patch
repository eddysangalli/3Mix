+//-----------------------------------------------------------------------------
+bool ConstString::isAsciiString () const
+{
+	uint32 i;
+	if (isWide)
+	{
+		for (i = 0; i < len; i++)
+			if (ConstString::isCharAscii (buffer16[i]) == false)
+				return false;
+	}
+	else
+	{
+		for (i = 0; i < len; i++)
+			if (ConstString::isCharAscii (buffer8[i]) == false)
+				return false;
+	}
+	return true;
+}
