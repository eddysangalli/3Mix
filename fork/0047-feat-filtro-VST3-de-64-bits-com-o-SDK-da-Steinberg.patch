+//-----------------------------------------------------------------------------
+// Project     : SDK Core
+//
+// Category    : SDK Core Interfaces
+// Filename    : pluginterfaces/base/iplugincompatibility.h
+// Created by  : Steinberg, 02/2022
+// Description : Basic Plug-in Interfaces
