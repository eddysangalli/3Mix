+//------------------------------------------------------------------------
+// Flags       : clang-format SMTGSequencer
+// Project     : VST3 SDK
+// Filename    : public.sdk/source/vst/utility/vst2persistence.h
+// Created by  : Steinberg, 12/2019
+// Description : vst2 persistence helper
+//
