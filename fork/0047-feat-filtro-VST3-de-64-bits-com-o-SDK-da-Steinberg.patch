@@ -0,0 +1,180 @@
+//------------------------------------------------------------------------
+// Project     : VST SDK
+//
+// Category    : Interfaces
+// Filename    : pluginterfaces/vst/ivsttransportcontrol.h
+// Created by  : Steinberg, 03/2026
+// Description :
+//
