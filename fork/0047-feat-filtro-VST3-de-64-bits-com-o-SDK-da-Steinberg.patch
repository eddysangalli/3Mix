+//------------------------------------------------------------------------
+// Project     : SDK Base
+// Version     : 1.0
+//
+// Category    : Helpers
+// Filename    : base/thread/source/fcondition.cpp
+// Created by  : Steinberg, 1995
+// Description : signals...
+//
+//-----------------------------------------------------------------------------
