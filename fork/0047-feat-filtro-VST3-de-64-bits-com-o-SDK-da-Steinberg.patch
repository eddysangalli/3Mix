+//-----------------------------------------------------------------------------
+// Project     : VST SDK
+// Flags       : clang-format SMTGSequencer
+// Category    : Helpers
+// Filename    : public.sdk/source/vst/utility/systemtime.cpp
+// Created by  : Steinberg, 06/2023
+// Description : VST Component System Time API Helper
+//
