+//-----------------------------------------------------------------------------
+ParameterValueQueue::ParameterValueQueue (ParamID paramID) 
+: paramID (paramID)
+{ 
+	values.reserve (kQueueReservedPoints);
+	FUNKNOWN_CTOR
+}
