+//-----------------------------------------------------------------------------
+// Project     : VST SDK
+//
+// Category    : Interfaces
+// Filename    : pluginterfaces/vst/ivstcomponent.h
+// Created by  : Steinberg, 04/2005
+// Description : Basic VST Interfaces
