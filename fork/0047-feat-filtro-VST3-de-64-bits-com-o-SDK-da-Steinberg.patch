+	}
+
+	uint32 stringLength = (uint32) ((str) ? strlen16 (str) : 0);
+	n = n < 0 ? stringLength : Min<uint32> (n, stringLength);
+
+	if (n > 0)
+	{
+		int32 newlen = n + len;
