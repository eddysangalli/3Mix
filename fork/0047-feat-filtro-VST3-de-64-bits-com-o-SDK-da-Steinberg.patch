+//-----------------------------------------------------------------------------
+// Project     : VST SDK
+// Flags       : clang-format SMTGSequencer
+// Category    : Helpers
+// Filename    : public.sdk/source/vst/hosting/hostdataexchangehandler.h
+// Created by  : Steinberg, 06/2023
+// Description : VST Data Exchange API Host Helper
+//
+//-----------------------------------------------------------------------------
