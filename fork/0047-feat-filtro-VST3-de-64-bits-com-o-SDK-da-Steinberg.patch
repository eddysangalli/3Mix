+//-----------------------------------------------------------------------------
+// Project     : SDK Core
+// Version     : 1.0
+//
+// Category    : SDK Core Interfaces
+// Filename    : pluginterfaces/test/itest.h
+// Created by  : Steinberg, 01/2005
+// Description : Test Interface - Availability Depends on HOST  
