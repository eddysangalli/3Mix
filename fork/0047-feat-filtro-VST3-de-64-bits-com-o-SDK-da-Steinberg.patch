+//-----------------------------------------------------------------------------
+void ConstString::copyTo (IStringResult* result) const
+{
+	if (isWideString () == false)
+	{
+		result->setText (text8 ());
+	}
+	else
+	{
+		FUnknownPtr<IString> iStr (result);
+		if (iStr)
+		{
+			iStr->setText16 (text16 ());
+		}
+		else
+		{
+			String tmp (*this);
+			tmp.toMultiByte ();
+			result->setText (tmp.text8 ());
+		}
+	}
+}
