+//------------------------------------------------------------------------
+class LinuxThreadChecker : public ThreadChecker
+{
+public:
+	bool test (const char* failmessage = nullptr, bool exit = false) override
+	{
+		if (threadID == pthread_self ())
+			return true;
+		if (failmessage)
