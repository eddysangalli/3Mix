+//------------------------------------------------------------------------
+/** Helper to allocate a message */
+inline IMessage* allocateMessage (IHostApplication* host)
+{
+	TUID iid;
+	IMessage::iid.toTUID (iid);
+	IMessage* m = nullptr;
+	if (host->createInstance (iid, iid, (void**)&m) == kResultOk)
+		return m;
+	return nullptr;
+}
