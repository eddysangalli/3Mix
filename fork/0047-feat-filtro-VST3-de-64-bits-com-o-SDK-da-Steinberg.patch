+//------------------------------------------------------------------------
+// Project     : SDK Base
+// Version     : 1.0
+// 
+// Category    : Helpers
+// Filename    : base/source/timer.cpp
+// Created by  : Steinberg, 05/2006
+// Description : Timer class for receiving triggers at regular intervals
+// 
