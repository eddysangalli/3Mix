+		int32 sampleOffset;
+	};
+	std::vector<ParameterQueueValue> values;
+};
+
+//------------------------------------------------------------------------
+/** Implementation's example of IParameterChanges - not threadsave!.
+\ingroup hostingBase
+*/
+class ParameterChanges : public IParameterChanges
+{
+public:
