+//-----------------------------------------------------------------------------
+bool ConstString::scanInt64_8 (const char8* text, int64& value, bool scanToEnd)
+{
+	while (text && text[0])
+	{
+		if (sscanf (text, "%" FORMAT_INT64A, &value) == 1)
+			return true;
+		if (scanToEnd == false)
+			return false;
+		text++;
+	}
+	return false;
