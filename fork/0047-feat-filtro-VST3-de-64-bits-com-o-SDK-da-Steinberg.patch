+//-----------------------------------------------------------------------------
+ConstString::ConstString (const ConstString& str, int32 offset, int32 length)
+: buffer (str.buffer)
+, len (length < 0 ? (str.len - (offset > 0 ? offset : 0)) : length)
+, isWide (str.isWide)
+{
+	if (offset > 0)
+	{
+		if (isWide)
+			buffer16 += offset;
+		else
+			buffer8 += offset;
+	}
+}
