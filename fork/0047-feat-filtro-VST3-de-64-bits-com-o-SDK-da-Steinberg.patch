+//-----------------------------------------------------------------------------
+bool ConstString::scanHex_8 (const char8* text, uint8& value, bool scanToEnd)
+{
+	while (text && text[0])
+	{
+		unsigned int v; // scanf expects an unsigned int for %x
+		if (sscanf (text, "%x", &v) == 1)
+		{
+			value = (uint8)v;
+			return true;
+		}
+		if (scanToEnd == false)
+			return false;
+		text++;
+	}
+	return false;
+}
