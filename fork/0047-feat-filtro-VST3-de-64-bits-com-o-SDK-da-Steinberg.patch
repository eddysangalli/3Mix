+	#else
+		#define SMTG_CPU_ARM_64EC	0
+	#endif
+
+	#define SMTG_OS_WINDOWS_ARM	(SMTG_CPU_ARM_64EC || SMTG_CPU_ARM_64 || SMTG_CPU_ARM)
+
+	#define BYTEORDER kLittleEndian
+	
+	#define COM_COMPATIBLE	1
