+
+		if (buffer16 && str)
+		{
+			memcpy (buffer16 + len, str, n * sizeof (char16));
+			SMTG_ASSERT (buffer16[newlen] == 0)
+		}
+
+		len += n;
+	}
+	return *this;
+}
