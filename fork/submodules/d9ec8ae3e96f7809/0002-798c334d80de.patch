+  } catch { /* endereço não HTTP: mantém o texto original */ }
+
+  const withAttempt = (n) => {
+    try {
+      const parsed = new URL(base);
+      parsed.searchParams.set('3mix_retry', String(n));
+      return parsed.href;
+    } catch { return base; }
+  };
+
+  retry.href = base;
+
+  try {
+    const parsed = new URL(base);
+    desk.href = parsed.origin + '/';
+  } catch { desk.href = 'http://127.0.0.1:18188/'; }
+
+  const isLocal = /^http:\/\/(127\.0\.0\.1|localhost)(:\d+)?\//i.test(base);
+
+  if (!isLocal) {
+    status.textContent = 'Endereço não local: a reconexão automática está desativada.';
+  } else if (attempt >= MAX) {
+    status.textContent = 'Tentativas automáticas pausadas após ' + MAX + ' tentativas. Use “Tentar agora”.';
+  } else {
+    let left = DELAY;
+    const tick = () => {
+      if (stopped) return;
+      status.textContent = 'Tentando reconectar em ' + Math.max(0, left) + 's · tentativa ' + (attempt + 1) + ' de ' + MAX;
+      if (left <= 0) {
+        window.location.replace(withAttempt(attempt + 1));
+        return;
+      }
+      left -= 1;
+      window.setTimeout(tick, 1000);
+    };
+    tick();
+  }
+
+  cancel.addEventListener('click', () => {
+    stopped = true;
+    status.textContent = 'Tentativas automáticas paradas. Use “Tentar agora” quando quiser.';
+  });
+
+  copy.addEventListener('click', async () => {
+    const text = base || failed;
+    try {
+      await navigator.clipboard.writeText(text);
+    } catch {
+      const area = document.createElement('textarea');
+      area.value = text;
+      area.style.position = 'fixed';
+      area.style.opacity = '0';
+      document.body.appendChild(area);
+      area.select();
+      try { document.execCommand('copy'); } catch { /* sem cópia disponível */ }
+      area.remove();
+    }
+    copy.textContent = 'Copiado';
+    window.setTimeout(() => { copy.textContent = 'Copiar'; }, 1600);
+  });
+})();
+</script>
