+.reason{margin-top:8px;border:1px solid #3a3324;background:#1c1912;border-radius:10px;padding:9px 12px;display:flex;gap:12px;align-items:baseline}
+.reason span{font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:#b99a63;white-space:nowrap}
+.reason strong{font:12.5px/1.45 "Cascadia Mono",Consolas,monospace;color:#f0d9ae;font-weight:500;overflow-wrap:anywhere}
+.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
+.btn{appearance:none;border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:9px;padding:10px 15px;font:600 13px "Segoe UI",sans-serif;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:8px}
+.btn:hover{border-color:#455563;background:#212b34}
+.btn.primary{background:#e9f2fb;border-color:#e9f2fb;color:#0d151c}
+.btn.primary:hover{background:#fff;border-color:#fff}
+.btn.ghost{background:transparent;color:var(--muted);border-color:transparent}
+.btn.ghost:hover{color:var(--text);background:rgba(255,255,255,.04)}
+.status{display:flex;align-items:center;gap:9px;margin-top:12px;color:var(--muted);font-size:12.5px;min-height:20px}
+.dot{width:7px;height:7px;border-radius:50%;background:var(--warn);box-shadow:0 0 0 4px rgba(227,178,91,.12);flex:none}
+.note{margin:10px 0 0;color:var(--dim);font-size:12px;max-width:62ch}
+details{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}
+summary{cursor:pointer;color:var(--muted);font-size:12.5px;font-weight:600}
+details ul{margin:10px 0 0;padding-left:18px;color:var(--muted);font-size:12.5px}
+details li{margin:5px 0}
+.foot{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:9px 22px;border-top:1px solid var(--line);background:#0f1419;color:var(--dim);font-size:11px}
+.foot strong{color:var(--muted);font-weight:600}
