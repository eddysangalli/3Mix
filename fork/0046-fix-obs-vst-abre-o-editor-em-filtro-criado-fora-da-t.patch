From 36f44c1f21904ca17153a3d5f03dd162458dd134 Mon Sep 17 00:00:00 2001
From: Eddy Sangalli <eddyrodrigues@outlook.com>
Date: Mon, 2 Nov 2026 17:45:08 -0300
Subject: [PATCH] fix: obs-vst abre o editor em filtro criado fora da thread da
 interface

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/obs-vst/VSTPlugin.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/plugins/obs-vst/VSTPlugin.cpp b/plugins/obs-vst/VSTPlugin.cpp
index 03c8bed..7a093cb 100644
--- a/plugins/obs-vst/VSTPlugin.cpp
+++ b/plugins/obs-vst/VSTPlugin.cpp
@@ -18,6 +18,7 @@ along with this program.  If not, see <http://www.gnu.org/licenses/>.
 
 #include "headers/VSTPlugin.h"
 #include <util/platform.h>
+#include <QCoreApplication>
 
 intptr_t VSTPlugin::hostCallback_static(AEffect *effect, int32_t opcode, int32_t index, intptr_t value, void *ptr,
 					float opt)
@@ -79,7 +80,11 @@ float VSTPlugin::GetSampleRate()
 	return mTimeInfo.sampleRate;
 }
 
-VSTPlugin::VSTPlugin(obs_source_t *sourceContext) : sourceContext{sourceContext} {}
+VSTPlugin::VSTPlugin(obs_source_t *sourceContext) : sourceContext{sourceContext}
+{
+	// Filtro criado pelo websocket nasce numa thread sem fila de eventos do Qt, e openEditor nunca rodaria.
+	moveToThread(QCoreApplication::instance()->thread());
+}
 
 VSTPlugin::~VSTPlugin()
 {
-- 
