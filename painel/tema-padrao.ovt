@OBSThemeMeta {
    name: '3Mix Grafite';
    id: 'local.mesadecorte.Yami';
    extends: 'com.obsproject.Yami';
    author: '3Mix';
    dark: 'true';
}

@OBSThemeVars {
    /* Neutral dark greys, flat, square: switcher look instead of the stock rounded blue */
    --grey1: #777777;
    --grey2: #494949;
    --grey3: #414141;
    --grey4: #303030;
    --grey5: #292929;
    --grey6: #242424;
    --grey7: #202020;
    --grey8: #191919;

    --mesa_preview: #16752c;
    --mesa_preview_dark: #125923;
    --mesa_program: #0e7a0d;
    --mesa_program_light: #16a014;
    --mesa_input: #3c4858;
    --mesa_onair: #c8281e;
    --mesa_onair_light: #e23a2e;

    --bg_window: var(--grey7);
    --bg_base: var(--grey6);
    --bg_preview: #202020;

    /* Colour only where it means something: green = active, orange = preview, red = on air */
    --primary: var(--mesa_program);
    --primary_light: var(--mesa_program_light);
    --primary_lighter: #3fc23c;
    --primary_dark: #0a5c0a;
    --primary_darker: #074207;

    --danger: var(--mesa_onair);

    --text: #e3e7ec;
    --text_light: #ffffff;
    --text_muted: #9aa3ad;

    --border_color: var(--grey2);
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;

    --input_bg: var(--grey4);
    --input_bg_hover: var(--grey3);
    --input_bg_focus: var(--grey8);
    --input_border: var(--grey2);
    --input_border_hover: var(--grey1);
    --input_border_focus: var(--mesa_preview);

    --list_item_bg_selected: var(--mesa_preview_dark);
    --list_item_bg_hover: var(--grey3);

    --button_bg: var(--grey4);
    --button_bg_hover: var(--grey3);
    --button_bg_down: var(--grey8);
    --button_bg_disabled: var(--grey6);
    --button_border: var(--grey2);
    --button_border_hover: var(--grey1);
    --button_border_focus: var(--grey1);

    --tab_bg: var(--grey5);
    --tab_bg_hover: var(--grey3);
    --tab_bg_down: var(--mesa_input);
    --tab_border: var(--grey2);
    --tab_border_selected: var(--mesa_preview);

    --scrollbar_handle: var(--grey3);
    --scrollbar_bg: var(--grey8);
    --scrollbar_hover: var(--grey2);
    --scrollbar_down: var(--grey1);

    --highlight_color: var(--mesa_preview);
    --dock_title_padding: calc(2px + var(--padding_base));
}

/* Window chrome */

QStatusBar,
OBSBasicStatusBar {
    background-color: var(--grey8);
}





QMainWindow::separator {
    background: var(--bg_window);
    border: none;
    width: 3px;
    height: 3px;
}

QMainWindow::separator:hover {
    background: var(--mesa_preview);
}

/* Dock headers read as input title bars */

QDockWidget {
    font-weight: bold;
}

QDockWidget::title {
    background-color: var(--mesa_input);
    padding: var(--dock_title_padding);
    text-align: left;
}

QDockWidget > QWidget {
    background: var(--bg_window);
}

/* Preview / Program title bars */

.label-preview-title {
    font-size: var(--font_large);
    font-weight: bold;
    color: #ffffff;
    background-color: var(--mesa_program);
    padding: 3px 8px;
    margin-bottom: 0px;
}

#previewLabel {
    background-color: var(--mesa_preview);
    color: #1a1206;
}

/* Scene buttons (grid mode) */

SceneTree {
    qproperty-gridItemWidth: 132;
    qproperty-gridItemHeight: 44;
}

.list-grid SceneTree::item {
    color: var(--text);
    background-color: var(--grey4);
    border: 1px solid var(--grey2);
    border-radius: 0px;
    margin: 2px;
    font-weight: bold;
}

.list-grid SceneTree::item:hover {
    background-color: var(--grey3);
}

.list-grid SceneTree::item:selected,
.list-grid SceneTree::item:selected:hover {
    background-color: var(--mesa_preview);
    border-color: var(--mesa_preview_dark);
    color: #1a1206;
}

.list-grid SceneTree::item:checked {
    background-color: var(--mesa_program);
    border-color: var(--mesa_program_light);
    color: #ffffff;
}

/* Buttons */

QPushButton {
    font-weight: bold;
}

QPushButton:pressed {
    background-color: var(--button_bg_down);
}

QPushButton:checked {
    background-color: var(--mesa_program);
    border-color: var(--mesa_program_light);
}

#transitionsFrame {
    padding: 6px;
    background: var(--bg_window);
    border: none;
}

#transitionsFrame QPushButton {
    min-height: 25px;
    margin: 0px;
    font-size: 11px;
    font-weight: 700;
    color: #e5ebf2;
    background-color: #2b3340;
    border: 1px solid #445063;
    border-radius: 2px;
}

#transitionsFrame QPushButton:hover {
    background-color: #384354;
    border-color: #5c6c84;
    color: #ffffff;
}

#transitionsFrame QPushButton:pressed {
    background-color: #1a2028;
    border-color: #2b3340;
}

/* Record / stream turn red while running, the other outputs green */

#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: var(--mesa_onair);
    border-color: var(--mesa_onair_light);
}

#streamButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: var(--mesa_onair_light);
}

/* T-bar */

.slider-tbar {
    min-height: 32px;
    padding: 4px 0px;
}

.slider-tbar::groove:horizontal {
    height: 6px;
    background: #0f1318;
    border: 1px solid #364252;
    border-radius: 2px;
}

.slider-tbar::sub-page:horizontal {
    background: var(--mesa_program);
    border-radius: 2px;
}

.slider-tbar::handle:horizontal {
    background: #c8d0da;
    border: 1px solid #1c222a;
    width: 16px;
    margin-top: -8px;
    margin-bottom: -8px;
    border-radius: 2px;
}

.slider-tbar::handle:horizontal:hover {
    background: #ffffff;
}

/* 3Mix T-Bar vertical */
.slider-tbar::groove:vertical {
    background: #111111;
    border: 1px solid #5a5a5a;
    width: 10px;
    border-radius: 4px;
}

.slider-tbar::handle:vertical {
    background: #d0d0d0;
    border: 1px solid #808080;
    height: 24px;
    margin: 0px -9px;
    border-radius: 3px;
}

.slider-tbar::handle:vertical:hover {
    background: #ffffff;
}

.slider-tbar::sub-page:vertical {
    background: #3a3a3a;
}

.slider-tbar::add-page:vertical {
    background: #1c1c1c;
}

/* Audio mixer */

#stackedMixerArea QScrollArea {
    background: var(--grey8);
}

#vVolumeWidgets VolumeControl {
    border-right: 1px solid var(--grey5);
}

.btn-mute.checked {
    background-color: var(--mesa_onair);
}

VolumeMeter {
    qproperty-backgroundNominalColor: rgb(18,70,18);
    qproperty-backgroundWarningColor: rgb(84,74,16);
    qproperty-backgroundErrorColor: rgb(88,22,18);
    qproperty-foregroundNominalColor: rgb(40,200,40);
    qproperty-foregroundWarningColor: rgb(240,210,40);
    qproperty-foregroundErrorColor: rgb(230,50,40);
    qproperty-magnitudeColor: rgb(0,0,0);
    qproperty-majorTickColor: var(--text);
    qproperty-minorTickColor: var(--text_muted);
}

/* Tabs */

QTabBar::tab:selected {
    background-color: var(--mesa_input);
}

/* Embedded panel */

QWidget {
    font-family: 'Segoe UI', 'Open Sans', Arial, sans-serif;
}

QDockWidget#Mesa_extraBrowser {
    font-size: 7pt;
    font-weight: normal;
    color: var(--text_muted);
}

QDockWidget#Mesa_extraBrowser::title {
    background-color: var(--grey8);
    padding: 1px 6px;
}

/* Preview without the zoom bar */

#previewXContainer {
    min-height: 0px;
    max-height: 0px;
    border: none;
    margin: 0px;
    padding: 0px;
}

#previewYScrollBar {
    min-width: 0px;
    max-width: 0px;
    border: none;
}

/* Settings window & dialogs */

QDialog {
    background-color: #171b22;
    color: #e6ebf2;
}

OBSBasicSettings {
    background-color: #171b22;
}

OBSBasicSettings QListWidget {
    background-color: #111419;
    border: 1px solid #2b3340;
    font-weight: 600;
    outline: none;
}

OBSBasicSettings QListWidget::item {
    padding: 9px 14px;
    margin: 0px;
    border-radius: 0px;
    border-bottom: 1px solid #1a2028;
    color: #b8c4d4;
}

OBSBasicSettings QListWidget::item:hover {
    background-color: #232b36;
    color: #ffffff;
}

OBSBasicSettings QListWidget::item:selected,
OBSBasicSettings QListWidget::item:selected:hover,
OBSBasicSettings QListWidget::item:selected:focus {
    background: linear-gradient(90deg, #0e8a16, #09630f);
    border-left: 3px solid #00e676;
    color: #ffffff;
    font-weight: 700;
}

OBSBasicSettings QGroupBox {
    background: #1c222b;
    border: 1px solid #2e3846;
    margin-top: 24px;
    padding: 12px 10px 10px 10px;
    border-radius: 2px;
}

OBSBasicSettings QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    background: linear-gradient(180deg, #2a3442, #1f2733);
    border: 1px solid #3d4a5c;
    border-bottom: 2px solid #0e8a16;
    color: #ffffff;
    font-weight: 700;
    padding: 4px 14px;
    min-width: 200px;
    border-radius: 2px;
}

/* Dialog controls & context menus */

QMenu {
    background-color: #1b2029;
    border: 1px solid #364254;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 24px 6px 20px;
    color: #dbe2ed;
}

QMenu::item:selected {
    background: #2a3545;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #2b3543;
    margin: 4px 6px;
}

QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #12151c;
    border: 1px solid #323d4e;
    color: #e6ebf2;
    padding: 4px 8px;
    border-radius: 2px;
}

QComboBox:hover, QLineEdit:hover, QSpinBox:hover {
    border-color: #4b5a70;
}

QComboBox:focus, QLineEdit:focus, QSpinBox:focus {
    border-color: #00e676;
}

QTabWidget::pane {
    border: 1px solid #2b3340;
    background-color: #171b22;
}

QTabBar::tab {
    background: #1f2631;
    border: 1px solid #2b3340;
    color: #a8b4c4;
    padding: 6px 14px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background: #283240;
    color: #ffffff;
}

QTabBar::tab:selected {
    background: #171b22;
    border-top: 2px solid #00e676;
    border-bottom: 1px solid #171b22;
    color: #ffffff;
    font-weight: 700;
}

/* FreeMix top area */

QMenuBar {
    background-color: var(--grey8);
    padding: 0px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 3px 9px;
}

QMenuBar::item:selected {
    background-color: var(--grey4);
}

QDockWidget#Menu_extraBrowser {
    min-height: 46px;
    max-height: 46px;
    font-size: 7pt;
    font-weight: normal;
    color: var(--text_muted);
}

QDockWidget#Menu_extraBrowser::title {
    background-color: var(--grey8);
    padding: 0px 6px;
}

/* Tally colours: red is on air, green is preview */

.label-preview-title {
    background-color: #ff0000;
    color: #ffffff;
}

#previewLabel {
    background-color: #006400;
    color: #ffffff;
}

/* Safe Area icon in the Preview title bar (button created by FreeMix.exe, widgets/FreeMixSafeArea.cpp). */
#freemixSafeAreaButton { background: transparent; border: none; color: #ffffff; padding: 0px 4px; margin: 0px; min-height: 0px; font-size: 15px; }
#freemixSafeAreaButton:hover { background: rgba(255, 255, 255, 45); }
#freemixSafeAreaButton::menu-indicator { image: none; width: 0px; }

/* Waveform / Vectorscope icon, to its left (widgets/FreeMixScope.cpp). */
#freemixScopeButton { background: transparent; border: none; padding: 0px 4px; margin: 0px; min-height: 0px; }
#freemixScopeButton:hover { background: rgba(255, 255, 255, 45); }
#freemixScopeButton::menu-indicator { image: none; width: 0px; }

/* Overlay channels 1 to 8 in the column between Preview and Output (widgets/FreeMixCenterColumn.cpp). */
.freemix-overlay { min-width: 0px; min-height: 22px; padding: 0px; font-weight: bold; }
.freemix-overlay:checked { background-color: #ff0000; color: #ffffff; border-color: #ff6a5e; }
.freemix-overlay:disabled { color: #56606c; }

/* Old menu bar hidden: the FreeMix bar replaces it. Its menus still open with Alt+letter. Remove this block to show it again. */

QMenuBar {
    min-height: 0px;
    max-height: 0px;
    padding: 0px;
    border: none;
}

/* Transition column */

#canvasEditor > QWidget > QPushButton,
MenuButton {
    background-color: #404b56;
    border: 1px solid #607081;
    border-radius: 0px;
    color: #f2f5f8;
    font-weight: bold;
    min-height: 20px;
    max-height: 24px;
    padding: 0px 6px;
    margin: 0px;
}

#canvasEditor > QWidget > QPushButton:hover,
MenuButton:hover {
    background-color: #526170;
}

MenuButton {
    min-width: 92px;
    max-width: 112px;
}

#canvasEditor > QWidget > QPushButton.icon-plus {
    min-width: 0px;
    max-width: 0px;
    min-height: 0px;
    max-height: 0px;
    border: none;
    margin: 0px;
    padding: 0px;
}

#canvasEditor > QWidget > QLabel {
    min-height: 0px;
    max-height: 0px;
    font-size: 1px;
    margin: 0px;
    padding: 0px;
}

#canvasEditor > QWidget > QLabel.label-preview-title {
    min-height: 20px;
    max-height: 26px;
    font-size: var(--font_large);
    padding: 3px 8px;
}

.freemix-transition-slot { min-width: 0px; padding: 0px 4px; font-size: 11px; font-weight: bold; }
#freemixTransitionColumn QPushButton { background-color:#404b56; border-color:#607081; }
#freemixTransitionColumn QPushButton:hover { background-color:#526170; }
#freemixTransitionColumn QPushButton:checked { background-color:#ff0000; }
#freemixTransitionColumn { background-color: #1e2328; }

/* The display clears its unused margins with this color too: CSS background alone does not affect it. */
OBSQTDisplay { qproperty-displayBackgroundColor: #1e2328; }
#canvasEditor, #previewContainer, #programContainer { background-color: #1e2328; border: none; }

/* 3Mix Grafite — acabamento da plataforma nativa existente. */
QDialog, OBSBasicSettings { background-color: #202020; color: #ededed; }
QMenu { background-color: #262626; border-color: #4a4a4a; }
QMenu::item:selected { background-color: #444444; }
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox { background-color: #252525; border-color: #505050; color: #ededed; border-radius: 3px; }
QTabWidget::pane { background-color: #202020; border-color: #444444; }
QTabBar::tab { background-color: #292929; border-color: #444444; color: #cccccc; }
QTabBar::tab:selected { background-color: #414141; border-top: 2px solid #cccccc; border-bottom: 1px solid #414141; }
OBSBasicSettings QListWidget { background-color: #202020; border-color: #444444; }
OBSBasicSettings QListWidget::item:selected { background: #454545; border-left: 3px solid #dddddd; }
OBSBasicSettings QGroupBox { background: #252525; border-color: #484848; border-radius: 4px; }
OBSBasicSettings QGroupBox::title { background: #303030; border-color: #505050; border-bottom: 1px solid #555555; }
#freemixTransitionColumn { background-color: #232323; }
#freemixTransitionColumn QPushButton, MenuButton { background-color: #353535; border-color: #555555; border-radius: 3px; }
#freemixTransitionColumn QPushButton:hover, MenuButton:hover { background-color: #484848; }
#freemixTransitionColumn QPushButton:checked { background-color: #c01920; }
.label-preview-title { background-color: #ed181d; color: #ffffff; padding: 5px 10px; }
#previewLabel { background-color: #16752c; color: #ffffff; }
#canvasEditor > QWidget > QLabel.label-preview-title { min-height: 24px; max-height: 30px; padding: 4px 10px; }
OBSQTDisplay { qproperty-displayBackgroundColor: #202020; }
#canvasEditor, #previewContainer, #programContainer { background-color: #202020; }
#freemixDskHeading { background: #292929; color: #eeeeee; padding: 5px; font-weight: bold; }
#freemixDskInput { background: #292929; border: 1px solid #484848; border-radius: 3px; color: #dddddd; padding: 4px; font-size: 11px; }
#freemixSwitcherControls { background: #232323; }
.slider-tbar::groove:vertical { background: #111111; border: 1px solid #555555; width: 9px; border-radius: 2px; }
.slider-tbar::handle:vertical { background: #c8c8c8; border: 1px solid #777777; height: 18px; margin-left: -15px; margin-right: -15px; border-radius: 3px; }
